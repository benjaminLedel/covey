# Egress proxy image for the hard isolation mode (COVEY_EGRESS_ISOLATION=network).
# Build: `make egress-image`. The control plane starts a proxy container from
# it that sits as the ONLY exit on the internal sandbox network and passes
# allowlist hosts only (allowlist from DB + ENV, reloaded live).
FROM golang:1.27 AS build
# Provenance of the binary (internal/buildinfo), as in Dockerfile.
ARG VERSION=dev
ARG COMMIT=
ARG DATE=
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/covey ./cmd/covey
COPY internal ./internal
COPY migrations ./migrations
COPY web ./web
# examples/ and skills/ hang off //go:embed (the agent templates and the Claude
# Code skill offered for download). The proxy never uses either, but it is the
# same binary — without those directories it does not compile.
COPY examples ./examples
COPY skills ./skills
# The proxy container never serves the SPA; a placeholder dist is enough for the
# //go:embed all:dist directive of the web package to build (no npm build needed).
RUN mkdir -p web/dist && [ -e web/dist/index.html ] || echo "egress-proxy" > web/dist/index.html
RUN CGO_ENABLED=0 go build -ldflags "\
        -X covey/internal/buildinfo.version=$VERSION \
        -X covey/internal/buildinfo.commit=$COMMIT \
        -X covey/internal/buildinfo.date=$DATE" -o /covey ./cmd/covey

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /covey /usr/local/bin/covey
ENTRYPOINT ["covey", "egress-proxy"]
