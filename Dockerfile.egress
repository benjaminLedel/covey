# Egress-Proxy-Image für den harten Isolationsmodus (COVEY_EGRESS_ISOLATION=network).
# Bauen: `make egress-image`. Die Control Plane startet daraus einen Proxy-
# Container, der auf dem internen Sandbox-Netz als EINZIGER Ausgang sitzt und
# nur Allowlist-Hosts durchlässt (Allowlist aus DB + ENV, live nachgeladen).
FROM golang:1.26 AS build
# Herkunft des Binaries (internal/buildinfo), analog Dockerfile.
ARG VERSION=dev
ARG COMMIT=
ARG DATE=
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/covey ./cmd/covey
COPY internal ./internal
COPY migrations ./migrations
COPY web ./web
# examples/ und skills/ hängen an //go:embed (Agenten-Vorlagen bzw. der zum
# Download angebotene Claude-Code-Skill). Der Proxy nutzt beides nie, aber es
# ist dasselbe Binary — ohne die Verzeichnisse kompiliert es nicht.
COPY examples ./examples
COPY skills ./skills
# Der Proxy-Container liefert die SPA nie aus; ein Placeholder-dist genügt, damit
# die //go:embed all:dist-Direktive des web-Pakets baut (kein npm-Build nötig).
RUN mkdir -p web/dist && [ -e web/dist/index.html ] || echo "egress-proxy" > web/dist/index.html
RUN CGO_ENABLED=0 go build -ldflags "\
        -X covey/internal/buildinfo.version=$VERSION \
        -X covey/internal/buildinfo.commit=$COMMIT \
        -X covey/internal/buildinfo.date=$DATE" -o /covey ./cmd/covey

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /covey /usr/local/bin/covey
ENTRYPOINT ["covey", "egress-proxy"]
