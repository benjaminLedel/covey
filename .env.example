# Covey — example configuration. Copy to .env and adjust:
#   cp .env.example .env
#
# .env does NOT belong in Git (see .gitignore).

# Required: 32-byte master key (64 hex characters) for the secret store.
# Generate with:  openssl rand -hex 32
# Without this key Covey does not start.
COVEY_MASTER_KEY=

# The address under which the SANDBOXES reach the control plane (leave as is for
# local tests — the docker provider turns it into host.docker.internal).
# This is an operational address: put the website's domain here and the sandboxes
# dial back over the open network, where the egress allowlist stops them — every
# agent then fails with "daemon did not connect".
# Behind a reverse proxy only set this to https://… if that address is reachable
# FROM INSIDE the sandbox containers AND is on the egress allowlist.
COVEY_PUBLIC_URL=http://localhost:8494

# The address under which this instance is reachable from OUTSIDE: website
# (canonical, sitemap.xml), the webhook and trigger URLs to copy, the target URL
# in the downloadable skill. Leaving it empty is the normal case — the server
# then derives it from the request (host + X-Forwarded-Proto) and the displayed
# URLs are right by themselves. Only set it when the reverse proxy does not pass
# the origin through, e.g. COVEY_SITE_URL=https://covey.example.com
#
# Rule of thumb: COVEY_PUBLIC_URL points inwards (sandboxes), COVEY_SITE_URL
# outwards (visitors and foreign systems).
COVEY_SITE_URL=

# The admin login `bootstrap` creates. Change this for any real deployment.
COVEY_ADMIN_EMAIL=admin@covey.local
COVEY_ADMIN_PASSWORD=covey-admin

# The image an agent's sandbox runs in. Fetch or build it once before the first
# wake:
#   make sandbox-images-pull   (all workplaces, minutes)
#   make sandbox-images        (builds them here instead: base, dev, the roles)
# Only worth setting if you build your own images under different names. Every
# profile of the catalogue has its variable, derived from its name (hyphens
# become underscores); the default profile additionally answers to the name from
# before the split.
# COVEY_SANDBOX_IMAGE=covey-sandbox:latest          # = COVEY_SANDBOX_IMAGE_BASE
# COVEY_SANDBOX_IMAGE_DEV=covey-sandbox-dev:latest
# COVEY_SANDBOX_IMAGE_DEV_FLUTTER=covey-sandbox-dev-flutter:latest
# COVEY_SANDBOX_IMAGE_DEV_PHP=covey-sandbox-dev-php:latest
# COVEY_SANDBOX_IMAGE_DEV_WEB=covey-sandbox-dev-web:latest
# COVEY_SANDBOX_IMAGE_DEV_FULL=covey-sandbox-dev-full:latest

# Optional: platform-wide wiki housekeeping heartbeat. Empty = off. When set,
# the control plane periodically creates a backlog task for every agent in which
# it tends its wiki memory (merge duplicates, fix dead [[links]]). Costs agent
# tokens per run. Format: "HH:MM" (daily, server time) or an interval like
# "24h"/"1d". Overridable per agent through a HEARTBEAT.md entry "Wiki aufräumen".
# COVEY_WIKI_CLEANUP=03:00

# The plugin catalogue the target-system store offers installs from (spec/22).
# One plain GET of one JSON file — no API, no token, no clone — so this works
# just as well against GitLab raw, an S3 bucket, an internal web server or a
# file:// path. Pointing it at your own file is how internal, non-public plugins
# are distributed; an empty value switches the catalogue off entirely and leaves
# the store with the compiled plugins plus whatever was uploaded by hand.
#
# Installing is always a person's decision — nothing is ever pulled in or
# updated by itself.
# COVEY_MARKETPLACE_URL=https://raw.githubusercontent.com/benjaminLedel/covey-plugins/main/catalog.json
