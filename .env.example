# Covey — Beispiel-Konfiguration. Kopieren nach .env und anpassen:
#   cp .env.example .env
#
# .env gehört NICHT ins Git (siehe .gitignore).

# Pflicht: 32-Byte-Master-Key (64 Hex-Zeichen) für den Secret-Store.
# Erzeugen mit:  openssl rand -hex 32
# Ohne diesen Schlüssel startet Covey nicht.
COVEY_MASTER_KEY=

# Adresse, unter der die SANDBOXEN die Control Plane erreichen (für lokale
# Tests so lassen — der docker-Provider macht daraus host.docker.internal).
# Das ist eine Betriebsadresse: Trägt man hier die Domain der Website ein,
# wählen die Sandboxen über das offene Netz zurück, wo die Egress-Allowlist sie
# stoppt — alle Agenten scheitern dann mit "daemon hat sich nicht verbunden".
# Hinter einem Reverse-Proxy nur dann auf https://… setzen, wenn diese Adresse
# aus den Sandbox-Containern heraus erreichbar UND in der Egress-Allowlist ist.
COVEY_PUBLIC_URL=http://localhost:8494

# Adresse, unter der diese Instanz von AUSSEN erreichbar ist: Website
# (canonical, sitemap.xml), die Webhook- und Trigger-URLs zum Kopieren, die
# Ziel-URL im herunterladbaren Skill. Leer lassen ist der Normalfall — dann
# leitet der Server sie aus dem Request ab (Host + X-Forwarded-Proto), und die
# angezeigten URLs stimmen von selbst. Nur setzen, wenn der Reverse-Proxy die
# Herkunft nicht durchreicht, z. B. COVEY_SITE_URL=https://covey.example.com
#
# Merksatz: COVEY_PUBLIC_URL zeigt nach innen (Sandboxen), COVEY_SITE_URL nach
# außen (Besucher und Fremdsysteme).
COVEY_SITE_URL=

# Admin-Login, das `bootstrap` anlegt. Für echte Deployments unbedingt ändern.
COVEY_ADMIN_EMAIL=admin@covey.local
COVEY_ADMIN_PASSWORD=covey-admin

# Optional: plattformweiter Wiki-Aufräum-Heartbeat. Leer = aus. Gesetzt legt die
# Control Plane jedem Agenten periodisch einen Backlog-Task an, in dem er sein
# Wiki-Gedächtnis pflegt (Duplikate zusammenführen, tote [[Verweise]] fixen).
# Kostet pro Lauf Agenten-Token. Format: "HH:MM" (täglich, Serverzeit) oder ein
# Intervall wie "24h"/"1d". Pro Agent per HEARTBEAT.md-Eintrag "Wiki aufräumen"
# überschreibbar.
# COVEY_WIKI_CLEANUP=03:00
