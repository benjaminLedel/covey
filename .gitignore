/seed
/tour

# Secrets & Logs — the master key must never reach the repo
.covey.key
.env
serve.log
covey.log

# Runtime data (the persistent agent homes, COVEY_DATA_DIR)
/data/

# Frontend
# Without the slash: a directory is caught the same way as the symlink that was
# once committed here by mistake (#152).
web/node_modules
web/dist/
web/dist-ssr/

# IDEs
.idea/

# Claude Code — local permissions of this working copy, not of the project
.claude/settings.local.json

# macOS
.DS_Store
web/tsconfig.tsbuildinfo

# Office lock files (the ~$ files of an open PowerPoint)
praesentationen/~$*

# Review scratch of an external tool — per-working-copy output, not project state
.impeccable/
