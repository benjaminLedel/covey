# Keep the build context small: only source plus go.mod/sum and the web/
# sources are needed (the Dockerfile builds frontend and binaries itself).
.git
.gitignore

# Locally prebuilt binaries — the image rebuilds them anyway.
/covey
/coveyd

# Runtime and local artefacts.
data/
*.log
.covey.key
.DS_Store

# Frontend artefacts: the sources stay, the build happens in the image.
web/node_modules/
web/dist/

# Not build-relevant.
praesentationen/
mockup/
# docs/ was build-relevant for one day: between #128 and #130 the frontend
# generated the documentation pages from it. The pages left the binary with the
# website (#130), so the build reads nothing here again — but whoever adds a
# build step that does has to take this line out, or the image build fails on
# a file that is simply not in the context.
docs/
