# Keep the build context small: only source plus go.mod/sum and the web/
# sources are needed (the Dockerfile builds frontend and binaries itself).
.git
.gitignore

# Locally prebuilt binaries — the image rebuilds them anyway.
/covey
/coveyd

# Runtime and local artefacts.
data/
*.log
.covey.key
.DS_Store

# Frontend artefacts: the sources stay, the build happens in the image.
web/node_modules/
web/dist/

# Not build-relevant.
praesentationen/
mockup/

# docs/ is deliberately NOT excluded. Since the documentation has one source
# (#128), web/docs.mjs reads it while building the frontend. Excluded, it was
# missing from the context and `npm run build` failed inside the image — while
# build-web stayed green in CI, where the whole repository is checked out.
