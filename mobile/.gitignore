# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The developer's signing team (#345), included by Debug/Release.xcconfig.
/ios/Flutter/Signing.xcconfig
/macos/Runner/Configs/Signing.xcconfig

# The app's Firebase project (#424): whoever ships the app puts their own
# here; without it the Android build has no push.
/android/app/google-services.json
# The same for the iPhone (#431): without it the iOS build has no push.
/ios/Runner/GoogleService-Info.plist
