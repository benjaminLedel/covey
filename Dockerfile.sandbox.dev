# Sandbox image, profile `dev`: base plus the toolchains a developer agent works
# on. Build: `make sandbox-image-dev` (builds base along with it).
#
# A profile is a UNION, not a language: the same agent works legitimately on a
# PHP and on a Flutter project, and one image per language would bring back
# exactly the question that "version → home, toolchain → image" has already
# answered — which one do I start on wake when it is not yet clear which ticket
# comes (spec/16-runner.md).
ARG BASE_IMAGE=covey-sandbox:latest
FROM ${BASE_IMAGE}

# The installations need root; at the end the agent stands again.
USER root

# Build toolchain for npm packages with a native part. node:26-slim brings
# neither make nor g++ nor python3, and exactly those three node-gyp looks
# for as soon as a project pulls a package like node-sass, sharp or bcrypt.
# The agent then sees an `npm install` that breaks off in the middle of the
# build, cannot install anything as non-root, and builds a replacement
# harness with stubs instead. ~250 MB that every developer agent carries;
# that is the price for "install dependencies" staying the first step
# instead of the first dead end.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential python3 \
    && rm -rf /var/lib/apt/lists/*

# PHP 8.2 + Composer for agents that work on PHP projects (Laravel).
# The version is not arbitrary: Debian trixie delivers 8.4, the CI of the target
# projects runs 8.2 — an agent that builds and tests against another minor
# version reports green and the pipeline goes red. So the packages from
# packages.sury.org, where 8.2 is still maintained. Extensions: zip/gd/ldap as in
# the project CI, plus the ones composer.json requires (dom/json/openssl/pdo)
# and pdo_sqlite, because PHPUnit runs there against an in-memory SQLite. Plus
# pgsql (projects whose test database is Postgres) and pcov: without a coverage
# driver every `phpunit --coverage-*` breaks off with "No code coverage
# driver available" — the agent reads that as a broken suite and starts repairing
# the test environment that was never broken. pcov instead of xdebug, because
# xdebug slows every test run by a multiple and contributes nothing else.
# As non-root the agent cannot install anything afterwards — what is missing
# here is missing for it at runtime.
# A side effect of sury one has to know about: the source brings its own rebuilds
# of some system libraries, and php8.2-gd pulls their libgd3 instead of the
# Debian version. That is unavoidable with sury (the dependency is built that
# way), but it means: a third-party repo delivers more than PHP here. So the
# source file is thrown out again in the same layer — the image should not carry
# an active foreign source, and the agent never needs apt anyway.
RUN curl -fsSL https://packages.sury.org/php/apt.gpg -o /usr/share/keyrings/sury-php.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/sury-php.gpg] https://packages.sury.org/php/ trixie main" \
         > /etc/apt/sources.list.d/sury-php.list \
    && apt-get update && apt-get install -y --no-install-recommends \
         php8.2-cli php8.2-xml php8.2-mbstring php8.2-curl php8.2-zip php8.2-gd \
         php8.2-ldap php8.2-sqlite3 php8.2-mysql php8.2-bcmath php8.2-intl composer \
         php8.2-pgsql php8.2-pcov \
    && rm -f /etc/apt/sources.list.d/sury-php.list \
    && rm -rf /var/lib/apt/lists/*

# A database server for test runs. The image carried the PHP extensions for MySQL
# and Postgres and no server along with them — a Laravel suite whose CI runs
# against MariaDB therefore had nothing to run against. One agent unpacked MariaDB
# into its home as a tarball after that: 1.4 GB, 21,951 files, looked through at
# every wake and written back after every run. ~150 MB here replace that, for
# everyone.
#
# The same reasoning as with pcov one level up: what is missing, the agent takes
# for a broken suite and starts repairing a test environment that was never
# broken.
#
# Started without systemd and without root: mariadbd runs as the agent, with a
# data directory in its home. The workplace tells it that (workplaces/dev.json) —
# otherwise it looks for the service that does not exist here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        mariadb-server mariadb-client \
    && rm -rf /var/lib/apt/lists/* /var/lib/mysql

# JDK for Kotlin/Java projects. Deliberately only ONE version: `gradlew` needs
# only a JVM to start and loads its Gradle itself; a project that requires a
# different JDK fetches it via Gradle's toolchain provisioning or SDKMAN into
# the Home. Every further JDK version here costs ~200 MB for every agent.
# JAVA_HOME is set because `gradlew` gets by with `java` from the PATH, but
# toolchain detection and Android tooling read the variable. The path carries
# the Debian architecture in its name, therefore derived rather than hardcoded.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends openjdk-21-jdk-headless; \
    rm -rf /var/lib/apt/lists/*; \
    ln -s "/usr/lib/jvm/java-21-openjdk-$(dpkg --print-architecture)" /opt/java
ENV JAVA_HOME=/opt/java

# Version managers for toolchains whose VERSION hangs on the project instead of
# the agent. They belong in the image, their SDKs do NOT: the control plane
# mounts the persistent Home over /home/agent (sandbox_docker.go) — what was
# installed here into /home/agent would be masked and invisible at runtime.
# So: binary in the system path, cache in the Home. Because the Home is
# persistent, every agent downloads an SDK exactly once and finds it on every
# further run.
#   fvm → Flutter/Dart, version from the project (.fvmrc), SDKs under ~/fvm
#   uv  → Python, version from .python-version, interpreters under ~/.local/share/uv
# fvm lies as a tree under /opt/fvm, not a single binary: the entry is a
# shell launcher that expects src/dart and src/fvm.snapshot NEXT to itself. It
# resolves symlinks for that (readlink -f), so a link on the PATH suffices.
# Versions are pinned on the release tag; that is no content pin (assets of a
# tag are replaceable), but it holds rebuilds stable over months — the same
# level as the npm package of the runtime in the base image. The architecture is
# NOT pinned: the image is built for amd64 or arm64 depending on the host.
ARG FVM_VERSION=4.1.2
ARG UV_VERSION=0.12.1
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
        amd64) fvm_arch=x64;   uv_arch=x86_64  ;; \
        arm64) fvm_arch=arm64; uv_arch=aarch64 ;; \
        *) echo "nicht unterstützte Architektur: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    tmp="$(mktemp -d)"; \
    curl -fsSL -o "$tmp/fvm.tar.gz" \
        "https://github.com/leoafarias/fvm/releases/download/${FVM_VERSION}/fvm-${FVM_VERSION}-linux-${fvm_arch}.tar.gz"; \
    tar -xzf "$tmp/fvm.tar.gz" -C "$tmp"; \
    rm -rf /opt/fvm; \
    mv "$tmp/fvm" /opt/fvm; \
    ln -s /opt/fvm/fvm /usr/local/bin/fvm; \
    curl -fsSL -o "$tmp/uv.tar.gz" \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${uv_arch}-unknown-linux-gnu.tar.gz"; \
    tar -xzf "$tmp/uv.tar.gz" -C "$tmp"; \
    install -m 0755 "$tmp/uv-${uv_arch}-unknown-linux-gnu/uv" /usr/local/bin/uv; \
    install -m 0755 "$tmp/uv-${uv_arch}-unknown-linux-gnu/uvx" /usr/local/bin/uvx; \
    rm -rf "$tmp"; \
    fvm --version; uv --version
# fvm links the active SDK into ~/fvm/default — that belongs in the PATH, or the
# agent does not find again the SDK it fetched itself. The rest of the
# PATH already stands in the base image.
ENV PATH=/home/agent/.npm-global/bin:/home/agent/.local/bin:/home/agent/fvm/default/bin:${PATH}

# The profile describes itself — the same file the interface shows.
# It overwrites the one of the base image: whoever starts `dev` should read
# about PHP, JDK and the version managers, not about what lies underneath.
COPY internal/sandbox/workplaces/dev.json /etc/covey/workplace.json

USER agent
WORKDIR /home/agent
ENTRYPOINT ["coveyd"]
