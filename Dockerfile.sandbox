# Sandbox-Image, Profil `base`: coveyd + Claude-Code-Runtime und das Werkzeug,
# das jeder Agent braucht — Support, Mail, QA, Recherche.
# Bauen: `make sandbox-image`. Die Control Plane startet daraus pro Wake einen
# Container; das persistente Agenten-Home wird nach /home/agent gemountet.
#
# Was hier NICHT drin ist, steht in Dockerfile.sandbox.dev: PHP, JDK, fvm, uv
# und die native Build-Toolchain. Der Schnitt geht bewusst nicht an Sprachen
# entlang, sondern an Rollen — ein Entwickler-Agent arbeitet legitim an einem
# PHP- UND einem Flutter-Projekt, und ein Mail-Agent an keinem von beiden
# (spec/16-runner.md, „Sandbox images per agent").
FROM golang:1.27 AS build
# Herkunft des Binaries (internal/buildinfo) — `coveyd version` im Container
# beantwortet, welcher Stand im Sandbox-Image liegt. Werte reicht der Aufrufer
# durch (make sandbox-image / CI); ohne Build-Args bleibt es "dev".
ARG VERSION=dev
ARG COMMIT=
ARG DATE=
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/coveyd ./cmd/coveyd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -ldflags "\
        -X covey/internal/buildinfo.version=$VERSION \
        -X covey/internal/buildinfo.commit=$COMMIT \
        -X covey/internal/buildinfo.date=$DATE" -o /coveyd ./cmd/coveyd

FROM node:26-slim
# Werkzeuge, die die Runtime in der Praxis braucht: git für Repos,
# ca-certificates + curl für HTTPS auf gebrokerte Zielsysteme, ripgrep für die
# Suche, unzip für ZIP-Archive (z. B. Mail-Anhänge, die der Agent in seine
# Sandbox lädt — als Nicht-Root kann er nichts nachinstallieren), chromium für
# das browser-Plugin (headless Chrome via chromedp; die nötigen Fonts/Libs
# zieht das chromium-Paket mit).
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates curl ripgrep unzip chromium \
    && rm -rf /var/lib/apt/lists/*
# Damit chromedp den Browser ohne Rätselraten findet.
ENV COVEY_BROWSER_CHROME_PATH=/usr/bin/chromium

# Browser-Testrunner auf das vorhandene chromium zeigen. Playwright und
# Puppeteer laden sonst beim ersten Lauf ihren eigenen Browser aus einem CDN —
# das steht in keiner Egress-Allowlist und läuft fail-closed ins Leere, während
# der Agent auf einen Download wartet, der nie kommt. Der Systembrowser ist nicht
# dieselbe Revision, gegen die der Runner gepinnt ist; für das Durchklicken einer
# Oberfläche reicht er, für einen pixelgenauen Snapshot-Vergleich nicht.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# UTF-8 als Sandbox-Locale. Ohne das läuft der Container im POSIX-Default:
# grep/sed/sort/wc/tr sehen dann Bytes statt Zeichen, unzip verstümmelt
# Dateinamen mit Umlauten, und der Agent lernt aus den kaputten Rückgaben, dass
# er deutschen Text lieber nach ASCII umschreibt („ue" statt „ü"). C.UTF-8 ist
# in glibc ab Debian bookworm eingebaut — kein locales-Paket nötig.
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN npm install -g @anthropic-ai/claude-code
# Erst NACH der Runtime-Installation: npm-Pakete, die der AGENT global
# installiert, gehören ins Home. Das Standard-Prefix /usr/local gehört root, der
# Container läuft als agent — `npm i -g` scheitert dort mit EACCES. Ein Prefix im
# Home behebt das und überlebt den Lauf, weil das Home als einziges Verzeichnis
# persistent ist (sandbox_docker.go). Diese Zeile darf nicht nach oben wandern:
# stünde sie vor dem Befehl darüber, läge die Runtime selbst im Home — und wäre
# zur Laufzeit vom gemounteten Home maskiert, also weg.
ENV NPM_CONFIG_PREFIX=/home/agent/.npm-global
# Was der Agent sich selbst ins Home installiert, liegt nicht im Standard-PATH.
# Der übliche Ausweg — der Installer ergänzt die .bashrc — greift hier nicht,
# weil das gemountete Home die Shell-Dateien aus dem Image maskiert.
ENV PATH=/home/agent/.npm-global/bin:/home/agent/.local/bin:${PATH}

# Nicht-root: Claude Code verweigert --dangerously-skip-permissions als root,
# und die Sandbox soll auch im Container kein Root-Prozess sein.
RUN useradd --create-home --uid 1001 agent
COPY --from=build /coveyd /usr/local/bin/coveyd

# Die Selbstbeschreibung des Arbeitsplatzes. Sie liegt im Repository (eine
# Datei, zwei Verbraucher: dieses Image und die Oberfläche), und coveyd hängt
# sie im Lauf an den Systemprompt — sonst sucht ein Agent Werkzeuge, die er
# schon hat, und lädt sie ein zweites Mal in sein Home (siehe
# internal/daemon/workplace.go).
COPY internal/sandbox/workplaces/base.json /etc/covey/workplace.json

USER agent
WORKDIR /home/agent
ENTRYPOINT ["coveyd"]
